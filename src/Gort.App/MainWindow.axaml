<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Gort.App.Windows"
        x:Class="Gort.App.MainWindow"
        Title="Tradutor de tela"
        Width="820" Height="640"
        Background="#F4F4F6"
        RequestedThemeVariant="Light">

  <DockPanel Margin="14">

    <!-- RF-503 — sempre visíveis: o título com a versão, o botão aplicar, o botão de
         doação e o indicador de memória. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0">
        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" />
        <TextBlock x:Name="Subtitle" Foreground="#606060" FontSize="12" />
      </StackPanel>
      <Button Grid.Column="1" x:Name="DonateButton" Padding="12,6" VerticalAlignment="Top" />
    </Grid>

    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="ApplyButton" Padding="20,8" />
        <Button x:Name="ShowWindowButton" Padding="14,8" />
        <TextBlock x:Name="MemoryIndicator" VerticalAlignment="Center"
                   Foreground="#606060" FontSize="12" />
        <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                   Foreground="#404040" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- V.1 — sete abas, em ordem fixa. -->
    <TabControl x:Name="Tabs">

      <!-- ── Aba 0 — configuração básica ─────────────────────────────────── -->
      <TabItem x:Name="TabBasic">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="OcrGroupLabel" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="EngineLabel" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EngineBox" HorizontalAlignment="Stretch" Margin="0,3" />
                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SourceLabel" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SourceBox" HorizontalAlignment="Stretch" Margin="0,3" />
                </Grid>
                <CheckBox x:Name="ShowOcrCheck" />
                <CheckBox x:Name="WriteFileCheck" />
                <CheckBox x:Name="CopyClipboardCheck" />
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ServiceGroupLabel" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ServiceLabel" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ServiceBox" HorizontalAlignment="Stretch" Margin="0,3" />
                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TargetLabel" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetBox" HorizontalAlignment="Stretch" Margin="0,3" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="DictionaryGroupLabel" FontWeight="SemiBold" />
                <CheckBox x:Name="UseDictionaryCheck" />
                <CheckBox x:Name="DictionaryWordCheck" />
              </StackPanel>
            </Border>

            <!-- RF-104 / RF-506 / RF-507 — correção de imagem. -->
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ImageGroupLabel" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <RadioButton x:Name="FilterNoneRadio" GroupName="filtro" Content="—" />
                  <RadioButton x:Name="FilterRgbRadio" GroupName="filtro" />
                  <RadioButton x:Name="FilterHsvRadio" GroupName="filtro" />
                  <RadioButton x:Name="FilterThresholdRadio" GroupName="filtro" />
                  <NumericUpDown x:Name="ThresholdBox" Width="110" Minimum="0" Maximum="255" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox x:Name="ErosionCheck" />
                  <Button x:Name="PreviewButton" Padding="12,6" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 1 — texto ───────────────────────────────────────────────── -->
      <TabItem x:Name="TabText">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" x:Name="FontLabel" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FontBox" HorizontalAlignment="Stretch" Margin="0,3" />
                  <TextBlock Grid.Row="1" Grid.Column="0" x:Name="FontSizeLabel" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="FontSizeBox"
                                 Minimum="8" Maximum="200" Margin="0,3" HorizontalAlignment="Left" Width="140" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="TextColorButton" Width="90" />
                  <Button x:Name="Stroke1Button" Width="90" />
                  <Button x:Name="Stroke2Button" Width="90" />
                  <Button x:Name="BackgroundButton" Width="90" />
                  <Button x:Name="RestoreColorsButton" Padding="12,6" />
                </StackPanel>

                <CheckBox x:Name="CenterCheck" />
                <CheckBox x:Name="RemoveSpacesCheck" />
                <CheckBox x:Name="UseBackgroundCheck" />
                <CheckBox x:Name="NumberAreasCheck" />
              </StackPanel>
            </Border>

            <!-- RF-508 a RF-510 — pré-visualização ao vivo, sem exigir "aplicar". -->
            <Border Background="#2A2A30" CornerRadius="6" Height="150">
              <w:LayerTextSurface x:Name="Preview" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 2 — configuração adicional ──────────────────────────────── -->
      <TabItem x:Name="TabAdditional">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="CaptureGroupLabel" FontWeight="SemiBold" />
                <CheckBox x:Name="ActiveWindowCheck" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="ScaleBox" Width="130" Minimum="0.1" Maximum="10" Increment="0.5" />
                  <Button x:Name="AttachedWindowButton" Padding="12,6" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="SpeedGroupLabel" FontWeight="SemiBold" />
                <ComboBox x:Name="SpeedBox" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="WindowGroupLabel" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox x:Name="WindowModeBox" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="AlwaysOnTopCheck" />
              </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ProfileGroupLabel" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="LoadProfileButton" Padding="12,6" />
                  <Button x:Name="SaveProfileButton" Padding="12,6" />
                  <Button x:Name="RestoreDefaultsButton" Padding="12,6" />
                </StackPanel>
                <CheckBox x:Name="CheckUpdatesCheck" Margin="0,8,0,0" />
                <CheckBox x:Name="StartBasicCheck" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 3 — tradução ────────────────────────────────────────────── -->
      <TabItem x:Name="TabTranslation">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ServiceLanguagesLabel" FontWeight="SemiBold" />
                <ItemsControl x:Name="ServiceLanguages" />
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <CheckBox x:Name="SpeakCheck" />
                <CheckBox x:Name="SpeakWaitCheck" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 4 — outros ──────────────────────────────────────────────── -->
      <TabItem x:Name="TabOther">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ShortcutsLabel" FontWeight="SemiBold" />
                <ItemsControl x:Name="ShortcutList" />
                <TextBlock x:Name="ShortcutHint" Foreground="#606060" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="HelpLabel" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="ManualButton" Padding="12,6" />
                  <Button x:Name="KnownErrorsButton" Padding="12,6" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 5 — configuração rápida ─────────────────────────────────── -->
      <TabItem x:Name="TabQuick">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="4,10">
            <Border Background="White" CornerRadius="6" Padding="16" BorderBrush="#DDD" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock x:Name="QuickStepText" FontSize="15" TextWrapping="Wrap" />
                <StackPanel x:Name="QuickColorChoices" Orientation="Horizontal" Spacing="10">
                  <RadioButton x:Name="QuickDarkRadio" GroupName="cor" />
                  <RadioButton x:Name="QuickLightRadio" GroupName="cor" />
                  <RadioButton x:Name="QuickUnknownRadio" GroupName="cor" IsChecked="True" />
                </StackPanel>
                <TextBlock x:Name="QuickSummary" Foreground="#606060" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="QuickNextButton" Padding="20,8" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Aba 6 — depuração (RF-490: só após ativar o modo) ───────────── -->
      <TabItem x:Name="TabDebug" IsVisible="False">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="4,10">
            <CheckBox x:Name="DebugUnlockSpeed" Content="Destravar velocidade" />
            <CheckBox x:Name="DebugShowCache" Content="Mostrar resultados de cache" />
            <CheckBox x:Name="DebugOneLine" Content="Traduzir uma linha por vez" />
            <CheckBox x:Name="DebugWordAreas" Content="Mostrar áreas de palavra" />
            <CheckBox x:Name="DebugSaveSnapshot" Content="Salvar resultado de análise" />
            <Button x:Name="DebugClearMemory" Content="Limpar memória de resultados" Padding="12,6"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
