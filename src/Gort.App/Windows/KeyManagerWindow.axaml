<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gort.App.Windows.KeyManagerWindow"
        Width="600" Height="400"
        Background="#F4F4F6"
        RequestedThemeVariant="Light"
        WindowStartupLocation="CenterOwner">

  <!-- RF-538 — lista com identificador, tipo e estado; campos; botão que alterna. -->
  <DockPanel Margin="14">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#606060" FontSize="12"
               TextWrapping="Wrap" Margin="0,8,0,0" />

    <Grid ColumnDefinitions="280,*" ColumnSpacing="12">
      <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1">
        <ListBox x:Name="KeyList" SelectionMode="Single" />
      </Border>

      <StackPanel Grid.Column="1" Spacing="8">
        <TextBlock x:Name="IdLabel" />
        <TextBox x:Name="IdBox" />
        <TextBlock x:Name="SecretLabel" />
        <TextBox x:Name="SecretBox" />

        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
          <RadioButton x:Name="FreeRadio" GroupName="tipo" IsChecked="True" />
          <RadioButton x:Name="PaidRadio" GroupName="tipo" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button x:Name="SaveButton" Padding="18,6" />
          <Button x:Name="RemoveButton" Padding="14,6" />
        </StackPanel>

        <Button x:Name="CloseButton" Padding="14,6" HorizontalAlignment="Left"
                Margin="0,10,0,0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
