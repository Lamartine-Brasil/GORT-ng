<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Gort.App.Windows"
        x:Class="Gort.App.Windows.OverlayWindow"
        Title="Sobreposição"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <w:OverlaySurface x:Name="Surface" />
</Window>
