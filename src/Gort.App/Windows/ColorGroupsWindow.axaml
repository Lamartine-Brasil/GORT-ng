<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gort.App.Windows.ColorGroupsWindow"
        Width="440" Height="330"
        Background="#F4F4F6"
        RequestedThemeVariant="Light"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- RF-534 — lista com caixas de seleção: índice, R/G/B e faixas S/V de cada grupo. -->
  <DockPanel Margin="14">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                Margin="0,10,0,0">
      <Button x:Name="CheckAllButton" Padding="12,6" />
      <Button x:Name="ApplyButton" Padding="18,6" />
      <Button x:Name="CancelButton" Padding="12,6" />
    </StackPanel>

    <Border Background="White" BorderBrush="#DDD" BorderThickness="1">
      <ScrollViewer>
        <ItemsControl x:Name="GroupList" Margin="8" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
