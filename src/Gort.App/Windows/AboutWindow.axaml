<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gort.App.Windows.AboutWindow"
        Width="460" Height="330"
        Background="#F4F4F6"
        RequestedThemeVariant="Light"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- RF-543 — versão, data de compilação, versões dos dicionários, links do autor. -->
  <StackPanel Margin="20" Spacing="10">

    <!-- Clicar no logotipo reexibe a tela de abertura. -->
    <Border x:Name="Logo" Background="#1E1E22" CornerRadius="8" Padding="14"
            HorizontalAlignment="Left" Cursor="Hand">
      <TextBlock Text="GORT" Foreground="White" FontSize="26" FontWeight="Bold" />
    </Border>

    <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" />
    <TextBlock x:Name="VersionText" Foreground="#404040" />
    <TextBlock x:Name="BuildText" Foreground="#606060" FontSize="12" />

    <TextBlock x:Name="DictionariesLabel" FontWeight="SemiBold" Margin="0,8,0,0" />
    <TextBlock x:Name="DictionariesText" Foreground="#606060" FontSize="12"
               TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="RepositoryButton" Padding="12,6" />
      <Button x:Name="ProjectButton" Padding="12,6" />
      <Button x:Name="CloseButton" Padding="12,6" />
    </StackPanel>
  </StackPanel>
</Window>
