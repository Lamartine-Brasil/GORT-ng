<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gort.App.Windows.DarkTranslationWindow"
        Title="Tradução"
        Width="760" Height="240"
        MinWidth="200" MinHeight="100"
        Background="#1E1E1E"
        SystemDecorations="Full"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*" Margin="0">

    <!-- RF-327 — indicador visível de "parado" quando o laço não está rodando. -->
    <Border Grid.Row="0" x:Name="StatusBar"
            Background="#2D2D30" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F0A030"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="parado" Foreground="#D0D0D0"
                   FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- RF-327 — caixa de texto rolável com fundo escuro. -->
    <ScrollViewer Grid.Row="1" x:Name="Scroller"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,10">
      <SelectableTextBlock x:Name="Body"
                           Text=""
                           Foreground="#F5F5F5"
                           TextWrapping="Wrap"
                           FontSize="15" />
    </ScrollViewer>
  </Grid>
</Window>
