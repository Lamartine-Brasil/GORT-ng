<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gort.App.Windows.SplashWindow"
        Width="420" Height="200"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border Background="#1E1E22" CornerRadius="10" Padding="28">
    <StackPanel Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="Tradutor de tela" FontSize="24" FontWeight="SemiBold"
                 Foreground="#F5F5F5" />
      <TextBlock x:Name="VersionText" FontSize="12" Foreground="#9A9AA0" />
      <TextBlock x:Name="StepText" FontSize="12" Foreground="#C8C8CE" Margin="0,14,0,0" />
    </StackPanel>
  </Border>
</Window>
